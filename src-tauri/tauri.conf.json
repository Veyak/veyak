{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyak",
  "version": "0.7.0",
  "identifier": "com.iamdhakrey.veyak",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Veyak",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Veyak/veyak/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxRkRFQkUyQTM4OTBFODkKUldTSkRvbWo0dXY5NGNLVEhMZkN3U0p6VVpNNE5xRlhteklrNzJvYWFPMEdwVTBpR09oOVM3Y0cK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "Veyak",
          "veyak"
        ]
      }
    }
  }
}